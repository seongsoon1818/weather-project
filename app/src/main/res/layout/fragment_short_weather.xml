<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/swipeShortRefresh"
    android:background="#F5F7FA">

    <ScrollView
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 현재 날씨 제목 -->
            <TextView
                android:id="@+id/tvShortTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 날씨"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <!-- 현재 날씨 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tvWeatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="72sp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--℃"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvPrecipitation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="강수 상태 확인 중"
                    android:textSize="18sp"
                    android:textColor="#555555"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvRainAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1시간 강수량: --mm"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:layout_marginTop="24dp" />

                <TextView
                    android:id="@+id/tvHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="습도: --%"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvWindSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="풍속: --m/s"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvWeatherStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="날씨 정보 요청 전"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:layout_marginTop="20dp" />

            </LinearLayout>

            <!-- 시간별 날씨 제목 -->
            <TextView
                android:id="@+id/tvHourlyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간별 날씨"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginTop="32dp" />

            <!-- 시간별 날씨 RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHourlyWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_hourly_weather" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>